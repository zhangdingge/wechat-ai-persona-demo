{
  "name": "cc-weixin",
  "version": "0.2.0",
  "type": "module",
  "description": "基于 cc-weixin 的微信 AI 角色机器人演示",
  "private": true,
  "keywords": [
    "wechat",
    "weixin",
    "claude",
    "bot",
    "ilink",
    "agent"
  ],
  "author": "hao-ji-xing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hao-ji-xing/cc-weixin.git"
  },
  "bin": {
    "cc-weixin": "./bin/cc-weixin"
  },
  "files": [
    "bin/",
    "cc-weixin.mjs",
    "lib/"
  ],
  "scripts": {
    "prestart": "node emotion-engine.cjs sync",
    "start": "node cc-weixin.mjs --no-tui",
    "login": "node emotion-engine.cjs sync && node cc-weixin.mjs --login --no-tui",
    "emotion:show": "node emotion-engine.cjs show",
    "emotion:event": "node emotion-engine.cjs event"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.81",
    "debug": "^4.4.3",
    "dotenv": "^17.3.1",
    "ink": "^6.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4"
  }
}
