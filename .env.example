# Default: a Claude Agent SDK-compatible provider.
MODEL_PROVIDER=claude
ANTHROPIC_API_KEY=replace-with-your-own-key
ANTHROPIC_BASE_URL=https://your-provider.example.com
ANTHROPIC_MODEL=your-text-model
ANTHROPIC_MODEL_VISION=your-vision-model

# To use ChatGPT plan usage instead, set MODEL_PROVIDER=chatgpt and run
# npm run chatgpt:login. No OpenAI API key is used by this mode.
# CHATGPT_MODEL=select-a-slug-from-npm-run-chatgpt:models

# Optional for Claude CLI mode, required for ordinary ChatGPT CLI mode:
# only reply to these exact WeChat user IDs. Separate multiple IDs with commas.
# WECHAT_ALLOWED_USER_IDS=first-user-id,second-user-id
